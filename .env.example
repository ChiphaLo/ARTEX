# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional Kali MCP overlay (--profile kali); disabled by default.
KALI_MCP_ENABLED=false
KALI_MCP_IMAGE=vxcontrol/kali-linux:mcp
KALI_MCP_URL=https://kali-mcp:8081/mcp
# Preferred: mkdir -p secrets/kali-mcp; openssl rand -hex 32 > secrets/kali-mcp/token
KALI_MCP_SECRET_DIR=./secrets/kali-mcp
KALI_MCP_TOKEN_FILE=/run/secrets/kali-mcp/token
# Alternative: set KALI_MCP_TOKEN and set KALI_MCP_TOKEN_FILE to an empty value.
KALI_MCP_TOKEN=
KALI_MCP_CA_CERT=/run/secrets/kali-mcp/service_ca.crt
KALI_MCP_DISABLE=
KALI_MCP_SHM_SIZE=512m
KALI_MCP_MEMORY=6g
KALI_MCP_BURP_ENABLED=false
KALI_MCP_BURP_ACCEPT_EULA=false
KALI_MCP_BURP_HEAP=1g
